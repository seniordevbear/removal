# --- notes ---
# DB_*: DigitalOcean managed MySQL. The server's IP must be added to the
#   database's Trusted Sources in the DO panel or connections time out.
# PD_UPLOAD_SECRET: must equal the web server's value, and this machine's IP
#   must be in PD_UPLOAD_IP_ALLOWLIST in the web server's .env.
# SOCKET_SERVER_*: legacy live-progress socket; nothing connects to it.
#   Keep HOST=127.0.0.1 PORT=5000 USE_SSL=false.

# Confirmation mailbox (read over IMAP by lib/email_verification.py and
# lib/mailbox_sweep.py). To move to Google Workspace: imap.gmail.com / 993 /
# the privacyduck.com mailbox / an app password.
CONFIRMATION_IMAP_PORT=993
CONFIRMATION_IMAP_FOLDERS=INBOX,Spam,Spam_Rejected
MAILBOX_SWEEP_INTERVAL=900

# --- Google Workspace mailbox (2026-10-10) -------------------------------
# Reading (lib/email_verification.py, lib/mailbox_sweep.py) and sending
# (lib/email_sender.py) are separate hosts on Workspace. The password is a
# 16-character APP PASSWORD, not the account password; 2-step verification
# must be on for the account first.
# CONFIRMATION_IMAP_SERVER=imap.gmail.com
# CONFIRMATION_IMAP_PORT=993
# CONFIRMATION_EMAIL_USER=removals@privacyduck.com
# CONFIRMATION_EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=removals@privacyduck.com
# FROM_EMAIL=removals@privacyduck.com
# Workspace allows ~2,000 external messages a day, so the 250 cap can rise:
# EMAIL_SENDER_TOTAL_PER_DAY=250
#
# The CCPA e-mail budget is the one that actually caps output. It was missing
# from this file, so the only way to find it was to read broker_helpers.py:
# the code falls back to 50 when the variable is unset, which is why a day's
# removals land in two tidy batches of fifty either side of midnight.
#
# 29 Oct 2026: 3,179 of the 6,024 rows queued for paying customers are CCPA
# e-mail. At 50/day that queue is 64 days deep; at 150 it is 21.
#
# Raise it in steps, not in one jump - removals@privacyduck.com only began
# sending on 15 Oct 2026 and a young identity sending six times its usual
# volume is what gets an account throttled. 150 first, then 300 once a few
# days have passed with clean bounces.
# CCPA_TOTAL_PER_DAY=150

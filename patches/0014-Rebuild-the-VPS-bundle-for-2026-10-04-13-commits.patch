+++    screenshot_path = None
+++    with safe_chromium_for_broker(broker_name,
+++                                  headless=(run_mode == "headless")) as page:
+++        try:
+++
+++            def _has_form():
+++                for sel in ("css:input[name*='[fname]']",
+++                            "css:input[name*='first' i]",
+++                            "css:.wpforms-field-name-first"):

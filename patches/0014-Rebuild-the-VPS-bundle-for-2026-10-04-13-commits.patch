+++                last_ts = last_removal_processed_at.get_value(user_id_str)
+++                if last_ts and (now_ts - last_ts) < REMOVAL_MIN_INTERVAL_SECONDS:
+++                    continue
+++                with _inflight_lock:
+++                    if user_id_str in _inflight_users:
+++                        continue
+++                    _inflight_users.add(user_id_str)

+def wait_text(page, needles, timeout=10):
+    """Return the first needle that appears in page.html within timeout."""
+    from time import sleep, time
+    end = time() + timeout
+    while time() < end:
+        html = page.html or ""
+        for n in needles:
+            if n in html:
+                return n
+        sleep(0.5)
+    return None

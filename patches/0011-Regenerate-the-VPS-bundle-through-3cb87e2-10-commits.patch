++        FROM (SELECT * FROM results WHERE step = 0 AND kind = 0
++                AND target_domain IN (""" + placeholders + """) LIMIT 1000) AS t
++        LEFT JOIN users u ON t.user_id = u.id
++    """, tuple(domains))

++    global daily email cap). Discovered once by scanning sites/*.py for the
++    run_ccpa_email_optout call, so no per-script registry has to be kept."""
++    global _CCPA_DOMAINS_CACHE
++    if _CCPA_DOMAINS_CACHE is None:
++        found = set()

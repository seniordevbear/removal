++        try:
++            for fname in os.listdir(sites_dir):
++                if not fname.endswith(".py"):
++                    continue
++                try:
++                    with open(os.path.join(sites_dir, fname), "r", encoding="utf-8", errors="ignore") as f:
++                        if "run_ccpa_email_optout" in f.read():

++        SELECT t.*, u.email, u.firstname, u.lastname, u.city, u.zip, u.state, u.age
++        FROM (SELECT * FROM results WHERE step = 0 AND kind = 3 LIMIT 1000) AS t
++        LEFT JOIN users u ON t.user_id = u.id
++    """)

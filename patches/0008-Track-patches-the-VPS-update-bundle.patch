diff --git a/patches/vps-files-2026-10-03/__removal.py b/patches/vps-files-2026-10-03/__removal.py
new file mode 100644
index 0000000..293c480
--- /dev/null
+++ b/patches/vps-files-2026-10-03/__removal.py
@@ -0,0 +1,250 @@
+# __removal.py — orchestration entry for kind=1 (removal) work.
+#
+# Responsibilities (this layer only):
+#   1. Validate PII coming from the DB. NEVER fabricate defaults that go
+#      out to a broker. If we don't have a city/zip/etc., we REFUSE and let
+#      the caller mark the row failed — sending a real opt-out request with
+#      "Los Angeles / California / 90029" against the wrong identity is
+#      both wrong (we'd match the wrong record) and a likely ToS violation.
+#   2. Import the broker module from `sites/<target_domain>`. Catch
+#      ModuleNotFoundError specifically and raise a distinct exception so
+#      the caller can mark the row as "module not implemented" (step=4)
+#      rather than "failed" (step=3). This keeps the dashboards from
+#      counting unimplemented brokers as failures.
+#   3. Call the broker's entrypoint inside a timeout. If it raises, the
+#      exception propagates with full traceback for upstream logging.
+#
+# Hard rule: this file MUST NOT contain hardcoded credentials, PII
+# defaults, or fallback values that get sent to brokers.
+import datetime
+import importlib
+import os
+import sys
+import threading
+import traceback
+
+
+# Globally required across ALL brokers. Kept intentionally narrow: only
+# fields that EVERY broker needs. Per-broker scripts can (and do) demand
+# additional fields by raising IncompletePII themselves -- a broker that
+# specifically needs Birth Year will skip itself for a user without one
+# while every other broker still runs.
+#
+# Policy change May 2026: was previously the full
+# (Name, City, State, Zipcode, Address, Birth Day, Birth Month, Birth Year)
+# which caused the pipeline to refuse to even TRY ~80% of brokers for any
+# paid user with so much as a missing ZIP. New behavior: try everything,
+# let per-broker validation reject what it actually needs.
+REQUIRED_FIELDS = (
+    "Name",
+)
+
+
+class ModuleMissing(Exception):
+    """Raised when sites.<target_domain> doesn't exist on disk.
+    Caller should mark the row with a distinct status (not generic failure)."""
+
+
+class IncompletePII(Exception):
+    """Raised when a removal row is missing fields needed to safely contact
+    the broker. Caller should mark the row as needing user attention."""
+
+
+def _build_data_row(email, firstname, lastname, city, zip, state, age,
+                    address, phone, birth_day, birth_month, birth_year,
+                    area_code, street, county):
+    """Build the dataRow dict broker scripts expect. ALL values are passed
+    through unchanged: if the caller has e.g. county="" then we pass "".
+    We do NOT substitute defaults here. Validation happens in
+    `validate_required_pii` below."""
+    name_full = "{} {}".format((firstname or "").strip(), (lastname or "").strip()).strip()
+    return {
+        "Verification Email": "webremovals@privacypros.com",
+        "User Email": email or "",
+        "Title": "Ms.",
+        "Name": name_full,
+        "Age": age if age else "",
+        "Birth Day": birth_day or "",
+        "Birth Month": birth_month or "",
+        "Birth Year": birth_year or "",
+        "Address": address or "",
+        "Area Code": area_code or "",
+        "Phone Number": phone or "",
+        "Street": street or "",
+        "Apartment": "",
+        "City": city or "",
+        "State": state or "",
+        "Zipcode": zip or "",
+        "County": county or "",
+        # These four were previously hardcoded fake values that got POSTed to
+        # brokers. Empty strings are safer: broker scripts will either accept
+        # them or visibly fail validation, but at least we're not impersonating
+        # someone else with plausible-looking data.
+        "Advertising Id": "",
+        "Job Title": "",
+        "Business Name": "",
+        "LinkedIn Profile": "",
+        "Status": "",
+    }
+
+
+def validate_required_pii(data_row, target_domain):
+    """Returns (ok: bool, missing: list[str]). Empty/None counts as missing."""
+    missing = []
+    for field in REQUIRED_FIELDS:
+        val = data_row.get(field)
+        if val is None or (isinstance(val, str) and val.strip() == ""):
+            missing.append(field)
+    return (len(missing) == 0), missing
+
+
+def _import_broker(target_domain):
+    """Import sites.<target_domain>. Distinguishes 'module file missing' from
+    'module file exists but has an import-time error' — the latter is a bug
+    in the broker script and shouldn't be silenced as "not implemented"."""
+    module_name = "sites." + target_domain
+    try:
+        return importlib.import_module(module_name)
+    except ModuleNotFoundError as e:
+        # e.name tells us *which* module was missing. If it's our broker module
+        # itself, that's "not implemented". If something downstream is
+        # missing (e.g. `from twocaptcha import TwoCaptcha` failed), that's a
+        # real bug to surface.
+        if getattr(e, "name", None) == module_name:
+            raise ModuleMissing(target_domain) from e
+        # downstream import error — re-raise so it shows up as a real failure
+        raise
+
+
+# --- screenshot folder: resolve per-run, not per-process ---------------------
+#
+# Nearly every script in sites/ computes, at *module import* time:
+#
+#     now            = datetime.datetime.now()
+#     current_date   = now.strftime("%Y-%m-%d")
+#     screentShotDir = os.path.join(base_dir, "ScreenShot", current_date)
+#     os.makedirs(screentShotDir, exist_ok=True)
+#
+# Python imports each module once per process. This service runs for weeks
+# without a restart, so `current_date` froze on the day the service happened
+# to start: every screenshot for the entire run piled into that one folder,
+# mislabelled for every day after the first, and NTFS degrades badly once a
+# directory holds hundreds of thousands of entries.
+#
+# The broker functions read these names as module *globals* at call time, so
+# rebinding them here — once per removal, at the single point where every
+# broker module is imported — fixes all 277 scripts without editing any of
+# them. Only names the script already defines are rebound, so a script that
+# does its own thing is left alone.
+_SCREENSHOT_DIR_LOCK = threading.Lock()
+
+
+def _refresh_screenshot_dir(module):
+    today = datetime.datetime.now().strftime("%Y-%m-%d")
+    if getattr(module, "current_date", None) == today:
+        return  # already current — the common case, no syscall needed
+    base = getattr(module, "base_dir", None) or os.getcwd()
+    out_dir = os.path.join(base, "ScreenShot", today)
+    try:
+        with _SCREENSHOT_DIR_LOCK:
+            os.makedirs(out_dir, exist_ok=True)
+    except OSError as e:
+        # Don't fail the removal over a screenshot folder; the broker will
+        # fall back to whatever path it already had.
+        print("[SCREENSHOT_DIR_FAILED] {} {}".format(out_dir, e),
+              file=sys.stderr, flush=True)
+        return
+    if hasattr(module, "now"):
+        module.now = datetime.datetime.now()
+    if hasattr(module, "current_date"):
+        module.current_date = today
+    if hasattr(module, "screentShotDir"):
+        module.screentShotDir = out_dir
+
+
+def removal(sio, target_domain, site_url, req_id, user_id, email, firstname,
+            lastname, city, zip, state, age, address, phone, birth_day,
+            birth_month, birth_year, area_code, street, county):
+    """Main entry. Returns the screenshot path on success.
+    On failure, raises (caller in manage.py catches and updates DB)."""
+    data_row = _build_data_row(
+        email, firstname, lastname, city, zip, state, age,
+        address, phone, birth_day, birth_month, birth_year,
+        area_code, street, county,
+    )
+
+    data_row["__user_id__"] = user_id  # for per-user throttles in helpers
+    # The listing URL the dashboard/scan recorded for this broker, if any.
+    # Email-path brokers ask for it ("link to the profile" — information.com,
+    # 2026-09-18) and the CCPA template includes it when present.
+    data_row["Profile URL"] = (site_url or "").strip()
+    ok, missing = validate_required_pii(data_row, target_domain)
+    if not ok:
+        # Surface a structured error so manage.py can mark the row with a
+        # specific status and log which fields are missing for ops to fix.
+        print(
+            "[REMOVAL_SKIPPED_MISSING_PII] req_id={} user_id={} domain={} missing={}".format(
+                req_id, user_id, target_domain, ",".join(missing)
+            ),
+            file=sys.stderr,
+            flush=True,
+        )
+        raise IncompletePII(missing)
+
+    try:
+        module = _import_broker(target_domain)
+    except ModuleMissing:
+        # Don't print traceback for this — it's an expected condition we want
+        # the caller to handle cleanly.
+        print(
+            "[REMOVAL_MODULE_MISSING] req_id={} user_id={} domain={}".format(
+                req_id, user_id, target_domain
+            ),
+            file=sys.stderr,
+            flush=True,
+        )
+        raise
+
+    _refresh_screenshot_dir(module)
+
+    fn = getattr(module, target_domain, None)
+    if not callable(fn):
+        # The module imported but doesn't export a function with the expected
+        # name. Treat as a bug to surface (not as "missing").
+        raise AttributeError(
+            "sites.{}: no callable named '{}'".format(target_domain, target_domain)
+        )
+
+    clean_site_url = (site_url or "").replace("https://", "").replace("http://", "")
+
+    try:
+        return fn(data_row, clean_site_url, data_row["User Email"], run_mode="non-headless")
+    except ModuleNotFoundError as e:
+        # Auto-generated stubs raise this from INSIDE the function (rather
+        # than at import time, which the _import_broker path above would
+        # catch). Treat it the same as a missing module so the row goes to
+        # step=4 (not_implemented) instead of step=3 (real failure).
+        if str(e).startswith("sites."):
+            print(
+                "[REMOVAL_MODULE_MISSING_INVOKE] req_id={} user_id={} domain={}".format(
+                    req_id, user_id, target_domain
+                ),
+                file=sys.stderr,
+                flush=True,
+            )
+            raise ModuleMissing(target_domain) from e
+        # any other ModuleNotFoundError = a real bug in the broker (e.g.
+        # forgot a `pip install`) — keep the loud failure
+        raise
+    except Exception:
+        # Make sure broker tracebacks land in stderr so they're captured by
+        # NSSM's AppStderr rotation. The bare `print(e)` in the old manage.py
+        # threw away the traceback which made bug-hunting impossible.
+        print(
+            "[REMOVAL_BROKER_RAISED] req_id={} user_id={} domain={}".format(
+                req_id, user_id, target_domain
+            ),
+            file=sys.stderr,
+        )
+        traceback.print_exc()
+        raise
diff --git a/patches/vps-files-2026-10-03/__scan.py b/patches/vps-files-2026-10-03/__scan.py
new file mode 100644
index 0000000..84a76ce
--- /dev/null
+++ b/patches/vps-files-2026-10-03/__scan.py
@@ -0,0 +1,110 @@
+# __scan.py — orchestration entry for kind=0 (scan) work.
+#
+# Companion to __removal.py — same hard rules:
+#   - No fabricated PII defaults. We pass user fields through unchanged.
+#   - ModuleNotFoundError from sites_scan.<domain> is raised as
+#     `ModuleMissing` so manage.py can mark the row distinctly. Today this
+#     matters a LOT: 408 of 413 scan domains have no module, generating
+#     376,309 step=3 (failed) rows that pollute dashboards. Promoting those
+#     to step=4 (not implemented) separates "broker we tried and failed"
+#     from "broker we never tried because we don't ship a script for it".
+import importlib
+import sys
+import traceback
+
+
+class ModuleMissing(Exception):
+    pass
+
+
+def _build_data_row(email, firstname, lastname, city, zip, state, age):
+    name_full = "{} {}".format((firstname or "").strip(), (lastname or "").strip()).strip()
+    return {
+        "Verification Email": "webremovals@privacypros.com",
+        "User Email": email or "",
+        "Title": "Ms.",
+        "Name": name_full,
+        # The old version substituted "none" / 20 for missing fields. We pass
+        # empties so broker scripts can detect-and-skip rather than search
+        # for the string "none" as if it were a real city.
+        "Age": age if age else "",
+        "Birth Day": "",
+        "Birth Month": "",
+        "Birth Year": "",
+        "Address": "",
+        "Area Code": "",
+        "Phone Number": "",
+        "Street": "",
+        "Apartment": "",
+        "City": city or "",
+        "State": state or "",
+        "Zipcode": zip or "",
+        "County": "",
+        "Advertising Id": "",
+        "Job Title": "",
+        "Business Name": "",
+        "LinkedIn Profile": "",
+        "Status": "",
+    }
+
+
+def _import_scan_module(target_domain):
+    module_name = "sites_scan." + target_domain
+    try:
+        return importlib.import_module(module_name)
+    except ModuleNotFoundError as e:
+        if getattr(e, "name", None) == module_name:
+            raise ModuleMissing(target_domain) from e
+        raise
+
+
+def scan(sio, target_domain, req_id, user_id, email, firstname, lastname,
+         city, zip, state, age):
+    data_row = _build_data_row(email, firstname, lastname, city, zip, state, age)
+
+    try:
+        module = _import_scan_module(target_domain)
+    except ModuleMissing:
+        print(
+            "[SCAN_MODULE_MISSING] req_id={} user_id={} domain={}".format(
+                req_id, user_id, target_domain
+            ),
+            file=sys.stderr,
+            flush=True,
+        )
+        raise
+
+    # 2026-10-03: every scan script starts with Name.split()[0]; an account
+    # with no name crashed as IndexError and was recorded as a broken broker.
+    if not str(data_row.get("Name", "")).strip():
+        from __removal import IncompletePII
+        raise IncompletePII(["Name"])

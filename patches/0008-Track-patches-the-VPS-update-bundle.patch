+    doms = ()
+    try:
+        cur = conn.cursor()
+        try:
+            cur.execute(
+                "SELECT target_domain FROM results "
+                "WHERE kind = 1 AND step IN (2, 3) AND updated_at >= NOW() - INTERVAL 7 DAY "
+                "GROUP BY target_domain "
+                "HAVING SUM(step = 2) = 0 AND SUM(step = 3) >= %s",
+                (DEAD_DOMAIN_FAILS,))
+            doms = tuple(r[0] for r in cur.fetchall())
+        finally:

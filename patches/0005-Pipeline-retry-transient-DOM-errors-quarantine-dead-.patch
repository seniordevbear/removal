+def _dead_domains(conn):
+    """Brokers with >= DEAD_DOMAIN_FAILS failures and NO success in the last
+    7 days. Their pending rows are held back from bulk selection — only the
+    daily probe row (_probe_dead_domains) runs, so a repaired script is still
+    noticed within a day. advancedbackgroundcheckscom had 0 successes ever and
+    still got 57 attempts in nine days. Cached 10 min per process."""
+    now = time.time()
+    if now - _dead_cache["at"] < 600:
+        return _dead_cache["domains"]
+    doms = ()
+    try:
+        cur = conn.cursor()
+        try:
+            cur.execute(
+                "SELECT target_domain FROM results "
+                "WHERE kind = 1 AND step IN (2, 3) AND updated_at >= NOW() - INTERVAL 7 DAY "
+                "GROUP BY target_domain "
+                "HAVING SUM(step = 2) = 0 AND SUM(step = 3) >= %s",
+                (DEAD_DOMAIN_FAILS,))
+            doms = tuple(r[0] for r in cur.fetchall())
+        finally:
+            cur.close()
+        if set(doms) != set(_dead_cache["domains"]):
+            log.info("quarantined brokers (no success in 7d): %d %s", len(doms), ",".join(sorted(doms))[:400])
+    except Exception:
+        log.exception("dead-domain query failed; selecting without quarantine")
+    _dead_cache["at"] = now
+    _dead_cache["domains"] = doms
+    return doms
+

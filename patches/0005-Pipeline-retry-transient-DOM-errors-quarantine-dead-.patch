+def _db_connect(attempts=3, backoff=2.0):
+    """mysql.connector.connect with retry. The managed DB occasionally drops
+    the connection or times out (seen in the 24 Sep-2 Oct logs: 'Lost
+    connection to MySQL server', 'connection attempt failed'); a whole tick
+    used to die on the first hiccup."""
+    last = None
+    for i in range(attempts):
+        try:
+            return mysql.connector.connect(**db_config)
+        except Exception as e:  # InterfaceError / OperationalError / socket
+            last = e
+            if i < attempts - 1:
+                log.warning("db connect failed (%d/%d): %s — retrying", i + 1, attempts, e)
+                time.sleep(backoff * (i + 1))
+    raise last
+
